{
  "$schema": "https://webreel.dev/schema/v1.json",
  "outDir": "out",
  "videos": {
    "commit-picker": {
      "url": "./mock.html",
      "viewport": {
        "width": 3200,
        "height": 1800
      },
      "output": "commit-picker.mp4",
      "fps": 60,
      "defaultDelay": 300,
      "clickDwell": 400,
      "waitFor": "#basePicker",
      "steps": [
        {
          "action": "pause",
          "ms": 900,
          "description": "settle"
        },
        {
          "action": "moveTo",
          "selector": "#basePicker",
          "description": "reach base picker"
        },
        {
          "action": "pause",
          "ms": 500
        },
        {
          "action": "click",
          "selector": "#basePicker",
          "description": "open dropdown"
        },
        {
          "action": "pause",
          "ms": 800
        },
        {
          "action": "moveTo",
          "selector": "[data-ver='v2 35c9533']",
          "description": "glide down the versions"
        },
        {
          "action": "pause",
          "ms": 500
        },
        {
          "action": "moveTo",
          "selector": "[data-ver='v1 8983284']",
          "description": "settle on v1"
        },
        {
          "action": "pause",
          "ms": 600
        },
        {
          "action": "click",
          "selector": "[data-ver='v1 8983284']",
          "description": "pick base = v1"
        },
        {
          "action": "pause",
          "ms": 1600,
          "description": "hold on the updated diff"
        }
      ],
      "zoom": 2
    }
  }
}